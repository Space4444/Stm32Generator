--cpu Cortex-M3
"stm32generator\startup_stm32f103xb.o"
"stm32generator\main.o"
"stm32generator\stm32f1xx_it.o"
"stm32generator\stm32f1xx_hal_msp.o"
"stm32generator\stm32f1xx_hal_gpio_ex.o"
"stm32generator\stm32f1xx_hal_tim.o"
"stm32generator\stm32f1xx_hal_tim_ex.o"
"stm32generator\stm32f1xx_hal.o"
"stm32generator\stm32f1xx_hal_rcc.o"
"stm32generator\stm32f1xx_hal_rcc_ex.o"
"stm32generator\stm32f1xx_hal_gpio.o"
"stm32generator\stm32f1xx_hal_dma.o"
"stm32generator\stm32f1xx_hal_cortex.o"
"stm32generator\stm32f1xx_hal_pwr.o"
"stm32generator\stm32f1xx_hal_flash.o"
"stm32generator\stm32f1xx_hal_flash_ex.o"
"stm32generator\stm32f1xx_hal_exti.o"
"stm32generator\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "Stm32Generator\Stm32Generator.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Stm32Generator.map" -o Stm32Generator\Stm32Generator.axf